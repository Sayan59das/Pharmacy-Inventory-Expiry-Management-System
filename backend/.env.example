# =====================================================================
# FILE        : backend/.env.example
# WHAT IT DOES: A TEMPLATE for the real settings file ".env".
#               The .env file tells the backend how to log in to MySQL.
# HOW TO USE  : 1. Copy this file and name the copy ".env" (same folder):
#                    Windows : copy .env.example .env
#                    Mac/Linux: cp .env.example .env
#               2. Open ".env" and put YOUR MySQL password after DB_PASSWORD=
# NEVER       : upload ".env" to GitHub - it contains your password. This
#               template has no real password, so it is safe to share.
# USED BY     : backend/db.py (reads these five values)
# =====================================================================

# The computer where MySQL runs ("localhost" = this computer).
DB_HOST=localhost

# The MySQL port. 3306 is the default; change it only if you installed MySQL on another port.
DB_PORT=3306

# The MySQL user name.
DB_USER=root

# The password of that MySQL user (the one you typed in MySQL Workbench).
DB_PASSWORD=your_mysql_password_here

# The database created by database/01_create_database.sql.
DB_NAME=pharmacy_db
