# =====================================================================
# FILE        : frontend/.env.example
# WHAT IT DOES: Template for frontend settings. Copy it to ".env" only if the
#               backend does NOT run at the default address below.
# USED BY     : src/api.js (reads VITE_API_URL). Restart "npm run dev" after a change.
# =====================================================================

# Address of the FastAPI backend (no slash at the end).
VITE_API_URL=http://127.0.0.1:8000
